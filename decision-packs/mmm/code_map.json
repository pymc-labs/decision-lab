      ],
      "call_template": "import cloudpickle\nfrom pymc_marketing.mmm.multidimensional import MMM\nfrom mmm_lib.data_preparation import load_csv_or_parquet_from_file\nfrom mmm_lib.model_fitting import prepare_mmm_data\n\nwith open($model_path, \"rb\") as f:\n    mmm = cloudpickle.load(f)\n\ndf = load_csv_or_parquet_from_file($data_path, verbose=False)\ntarget_column = mmm.output_var\ndate_column = mmm.date_column\n\nX, y = prepare_mmm_data(\n    df,\n    date_column=date_column,\n    y_column=target_column,\n)\n\nmmm.fit(\n    X=X,\n    y=y,\n    nuts_sampler=\"numpyro\",\n    draws=$draws,\n    tune=$tune,\n    chains=$chains,\n    target_accept=$target_accept,\n    random_seed=$seed,\n)\n\nmmm.save($output_path)"
